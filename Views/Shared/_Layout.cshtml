<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>ENT Forum @(ViewBag.Title != null ? "— " + ViewBag.Title : "")</title>
    <link rel="stylesheet" href="/css/wiki.css">
</head>
<body>

    <header class="site-header">
        
        <nav class="main-nav">
            <div class="newsButton">
                <a href="/">Новости сервера</a>
            </div>
            <div class="forumsButton">
                <a href="/forums">Список форумов</a>
            </div>
            <div class="wikiButton">
                <a href="/Wiki/Page?page=index">Wiki</a>
            </div>
            <div class="contactsButton">
                <a href="/contacts">Контакты</a>
            </div>
            <input type="text" name="userGET" placeholder="Поиск" size="18" />
        </nav>
    </header>

    <div class="page-wrapper">
        <aside class="wiki-sidebar">
            <a href="/" class="logo"></a>
            <h2>Навигация</h2>
            <a href="/Wiki/Page?page=spacelaw" class="SL-pagebutton">Космический закон</a>
            <a href="/Wiki/Page?page=generalsrp" class="SRP-pagebuttonGEN">Общее СРП</a>
            <a href="/Wiki/Page?page=commandsrp" class="SRP-pagebuttonCOM">СРП командования</a>
            <a href="/Wiki/Page?page=secsrp" class="SRP-pagebuttonSEC">СРП безопасности</a>
            <a href="/Wiki/Page?page=scisrp" class="SRP-pagebuttonSCI">СРП науки</a>
            <a href="/Wiki/Page?page=servsrp" class="SRP-pagebuttonSER">СРП сервиса</a>
            <a href="/Wiki/Page?page=lawsrp" class="SRP-pagebuttonLAW">СРП юриспруденции</a>
            <a href="/Wiki/Page?page=cargosrp" class="SRP-pagebuttonCARGO">СРП грузов</a>
            <a href="/Wiki/Page?page=engsrp" class="SRP-pagebuttonENG">СРП инженерии</a>
        </aside>

        <main class="wiki-content">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year ENTERPRISE</p>
    </footer>

</body>
</html>