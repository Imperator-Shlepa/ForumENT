<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>ENT Forum @(ViewBag.Title != null ? "— " + ViewBag.Title : "")</title>
    <link rel="stylesheet" href="/css/wiki.css">
    <link rel="icon" type="image/png" href="/images/icons/ENTLogo.png">
</head>
<body>

    <header class="site-header">
        
        <nav class="main-nav">
            <div class="newsButton">
                <a href="/">Новости сервера</a>
            </div>
            <div class="forumsButton">
                <a href="/forums">Форум !НЕ РАБОТАЕТ!</a>
            </div>
            <div class="wikiButton">
                <a href="/Wiki/Page?page=index">Вики сервера</a>
            </div>
            <div class="contactsButton">
                <a href="/contacts">Контакты</a>
            </div>
            <div class="discordButton">
                <a href="https://discord.gg/nSazFtphhJ">Наш дискорд</a>
            </div>
            <input type="text" name="userGET" placeholder="Поиск" size="18" />
        </nav>
    </header>

    <div class="page-wrapper">
        <aside class="wiki-sidebar">
            <a href="/" class="logo"></a>
            <h2>Навигация</h2>
            <div class="sidebar-button">
                <a href="/Wiki/Page?page=SOPS/spacelaw"><img src="/images/icons/IconCr.png" width="35" style="vertical-align: middle; image-rendering: pixelated;"> Корпоративный Закон</a>
            </div>
            
            <div class="sidebar-button">
                <a href="/Wiki/Page?page=SOPS/general-sop"><img src="/images/icons/IconQuenta.png" width="35" style="vertical-align: middle; image-rendering: pixelated;"> Общее СРП</a>
            </div>
    
        </aside>

        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year ENTERPRISE</p>
    </footer>

</body>
</html>