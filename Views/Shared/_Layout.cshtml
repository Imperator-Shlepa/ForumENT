<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>ENT Forum @(ViewBag.Title != null ? "— " + ViewBag.Title : "")</title>
    <link rel="stylesheet" href="/css/wiki.css">
</head>
<body>

    <header class="site-header">
        
        <nav class="main-nav">
            <div class="newsButton">
                <a href="/">Новости сервера</a>
            </div>
            <div class="forumsButton">
                <a href="/forums">Список форумов</a>
            </div>
            <div class="wikiButton">
                <a href="/Wiki/Page?page=index">Wiki</a>
            </div>
            <div class="contactsButton">
                <a href="/contacts">Контакты</a>
            </div>
            <input type="text" name="userGET" placeholder="Поиск" size="18" />
        </nav>
    </header>

    <div class="page-wrapper">
        <aside class="wiki-sidebar">
            <a href="/" class="logo"></a>
            <h2>Навигация</h2>
            <a href="/Wiki/Page?page=spacelaw" class="spl-pagebutton">Космический закон</a>
        </aside>

        <main class="wiki-content">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year ENTERPRISE</p>
    </footer>

</body>
</html>