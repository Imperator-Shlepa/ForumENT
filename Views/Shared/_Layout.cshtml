<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>ENT Forum @(ViewBag.Title != null ? "— " + ViewBag.Title : "")</title>
    <link rel="stylesheet" href="/css/wiki.css">
</head>
<body>

    <header class="site-header">
        
        <nav class="main-nav">
            <div class="newsButton">
                <a href="/">Новости сервера</a>
            </div>
            <div class="forumsButton">
                <a href="/forums">Форум !НЕ РАБОТАЕТ!</a>
            </div>
            <div class="wikiButton">
                <a href="/Wiki/Page?page=index">Вики сервера</a>
            </div>
            <div class="contactsButton">
                <a href="/contacts">Контакты</a>
            </div>
            <div class="discordButton">
                <a href="https://discord.gg/nSazFtphhJ">Наш дискорд</a>
            </div>
            <input type="text" name="userGET" placeholder="Поиск" size="18" />
        </nav>
    </header>

    <div class="page-wrapper">
        <aside class="wiki-sidebar">
            <a href="/" class="logo"></a>
            <h2>Навигация</h2>
            <div class="SL-pagebutton">
                <a href="/Wiki/Page?page=spacelaw">Космический закон</a>
            </div>

            <div class="SRP-pagebuttonCOM">
                <a href="/Wiki/Page?page=commandsrp">СРП командования</a>
            </div>

            <div class="SRP-pagebuttonSEC">
                <a href="/Wiki/Page?page=secsrp">СРП безопасности</a>
            </div>

            <div class="SRP-pagebuttonSCI">
                <a href="/Wiki/Page?page=scisrp">СРП науки</a>
            </div>

            <div class="SRP-pagebuttonSER">
                <a href="/Wiki/Page?page=servsrp">СРП сервиса</a>
            </div>

            <div class="SRP-pagebuttonLAW">
                <a href="/Wiki/Page?page=lawsrp">СРП юриспруденции</a>
            </div>

            <div class="SRP-pagebuttonCARGO">
                <a href="/Wiki/Page?page=cargosrp">СРП грузов</a>
            </div>

            <div class="SRP-pagebuttonENG">
                <a href="/Wiki/Page?page=engsrp">СРП инженерии</a>
            </div>

            <div class="SRP-pagebuttonGEN">
                <a href="/Wiki/Page?page=generalsrp">Общее СРП</a>
            </div>

            <div class="SRP-pagebuttonMED">
                <a href="/Wiki/Page?page=medsrp">СРП медицины</a>
            </div>

              
        </aside>

        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year ENTERPRISE</p>
    </footer>

</body>
</html>